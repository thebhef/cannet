{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cannet",
  "version": "0.0.0",
  "identifier": "dev.cannet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "uv run --no-project ../../scripts/build-sidecar.py && uv run --no-project ../../scripts/stage-server.py && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "cannet",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar-dist/cannet-python-can": "cannet-python-can",
      "server-dist": "",
      "licenses.json": "licenses.json"
    }
  }
}
